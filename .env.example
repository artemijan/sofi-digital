# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Generate a key with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

# Wrap values in single quotes if they contain =, #, $, (, !, & or spaces:
# django-environ strips the quotes, and the file stays safe to `source` or
# feed to docker --env-file.
SECRET_KEY='replace-me'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# SQLite lives in the project root by default.
DATABASE_URL=sqlite:///db.sqlite3

# consolemail:// prints emails to stdout. For real SMTP use:
#   EMAIL_URL=smtp://user:password@smtp.example.com:587/?tls=True
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=shop@sofi.local

# Static & media. Leave both at their defaults for local development.
#
# In production the collected assets live on a CDN, so STATIC_URL becomes an
# absolute URL with a trailing slash — Django refuses to serve static files with
# DEBUG off, and nothing else on the server does. SERVE_MEDIA makes Django serve
# MEDIA_ROOT anyway, which it must, because the Oscar dashboard writes product
# images there at runtime. Set it to False only when a real web server or object
# store has taken over /media/.
STATIC_URL=/static/
SERVE_MEDIA=True

# Storefront
OSCAR_SHOP_NAME=Sofi
OSCAR_SHOP_TAGLINE=
OSCAR_DEFAULT_CURRENCY=EUR

# Bootstrap admin account (used by: uv run python manage.py createsuperuser --noinput)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-me
